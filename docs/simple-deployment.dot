digraph G {
    node [shape=box];
    edge [color=blue];
    
    subgraph cluster_server {
        label="Server";

        nats_service [label="NATS"];
    }

    subgraph cluster_agent {
        label="Agent";

        osquery_nats_agent [label="osquery/NATS agent"];
        osqueryi;
        files [label="File(s)"];

        osquery_nats_agent -> osqueryi;
        osquery_nats_agent -> nats_service [dir="both"];
        osquery_nats_agent -> files [dir="both"];
    }
}